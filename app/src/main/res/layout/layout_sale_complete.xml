   <TextView android:id="@+id/view_shift" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="▤  View my shift summary" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
