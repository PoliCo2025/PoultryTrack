<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   <ViewStub android:id="@+id/harvest_empty_state" android:layout="@layout/pt_state_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" /><ViewStub android:id="@+id/harvest_error_state" android:layout="@layout/pt_state_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_pending_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌁  Harvest saved locally" android:textColor="@color/status_pending" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="600 eggs added to inventory at 10:15 AM. Queued for cloud sync when internet returns." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pending sync" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Harvest date" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_date" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="8 Oct 2026" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Collection time" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/collection_time" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="10:15 AM" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Collected eggs" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Small" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_small" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="60" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <ViewStub android:id="@+id/harvest_invalid_quantity" android:layout="@layout/pt_invalid_field" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Medium" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_medium" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="180" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Large" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_large" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="240" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Extra large" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_xl" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="120" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total harvested" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="600 eggs" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="20 trays equivalent" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notes" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/harvest_notes" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="Morning collection completed" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <TextView android:id="@+id/save_harvest" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="＋  Record harvest" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
