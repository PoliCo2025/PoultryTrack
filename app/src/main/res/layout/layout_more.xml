<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_success_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  Elena Reyes" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Maligaya Egg Farm · Bulacan" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Administrator" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Farm administration" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:id="@+id/users" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="♙" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="User management" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Accounts and role permissions" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <LinearLayout android:id="@+id/pricing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="₱" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Egg pricing" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set farm-gate prices by egg size" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <LinearLayout android:id="@+id/adjustment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="◉" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inventory adjustments" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Review requests from users" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <LinearLayout android:id="@+id/reports" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="▥" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Farm-wide reports" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sales, inventory and PDF exports" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Device &amp; records" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:id="@+id/sync_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="↻" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync status &amp; backup" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2 pending · Last synced 9:58 AM" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <LinearLayout android:id="@+id/shift_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="▤" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My shift summary" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personal sales and cash report" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <TextView android:id="@+id/sign_out" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="↪  Sign out" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="Farm Counter 01 · PoultryTrack 1.0 · Android" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
