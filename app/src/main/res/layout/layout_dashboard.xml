<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   <ViewStub android:id="@+id/dashboard_loading_state" android:layout="@layout/pt_state_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   <ViewStub android:id="@+id/dashboard_empty_state" android:layout="@layout/pt_state_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="6dp" android:text="Maligaya Egg Farm · Bulacan" android:textColor="@color/farm_green" android:textSize="11sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_success_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  Your shift is open" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="On duty" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Started 8:00 AM · Farm Counter 01" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Today at a glance" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SALES TODAY" android:textColor="@color/muted_gray_green" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱3,000" android:textColor="@color/dark_charcoal_green" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="6 cash transactions" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EGGS SOLD" android:textColor="@color/muted_gray_green" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="390" android:textColor="@color/dark_charcoal_green" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="13 trays equivalent" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AVAILABLE STOCK" android:textColor="@color/muted_gray_green" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3,780" android:textColor="@color/dark_charcoal_green" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="13 days equivalent" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY'S HARVEST" android:textColor="@color/muted_gray_green" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="600" android:textColor="@color/dark_charcoal_green" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved at 10:15 AM" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout></LinearLayout>
   <TextView android:id="@+id/new_sale" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="＋  New sale" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Quick actions" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:id="@+id/record_harvest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="◉" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Record harvest" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add collected eggs by size" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <LinearLayout android:id="@+id/shift_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/role_chip" android:gravity="center" android:text="▤" android:textColor="@color/farm_green" android:textSize="15sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My shift summary" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sales, cash and PDF report" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="@color/muted_gray_green" android:textSize="20sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="3 records waiting to sync" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_pending_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌁  Pending sync" android:textColor="@color/status_pending" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Local records are saved on this device and will sync when internet is available." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
