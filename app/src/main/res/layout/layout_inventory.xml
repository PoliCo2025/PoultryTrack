<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:orientation="vertical">

    <include layout="@layout/pt_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <ViewStub
                android:id="@+id/inventory_loading_state"
                android:layout="@layout/pt_state_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <ViewStub
                android:id="@+id/inventory_empty_state"
                android:layout="@layout/pt_state_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <ViewStub
                android:id="@+id/inventory_error_state"
                android:layout="@layout/pt_state_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/status_success_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓  Available on this device"
                    android:textColor="@color/status_success"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3,780 eggs"
                    android:textColor="@color/dark_charcoal_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="126 trays equivalent · Updated 10:42 AM"
                    android:textColor="@color/muted_gray_green"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="Stock by egg size"
                android:textColor="@color/dark_charcoal_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@drawable/login_card"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Small" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱6.00 / egg" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="600 eggs" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/chart_bar_track" android:weightSum="1000">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="408" android:background="@drawable/chart_bar_fill" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@drawable/login_card"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medium" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱7.00 / egg" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,080 eggs" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/chart_bar_track" android:weightSum="1000">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="735" android:background="@drawable/chart_bar_fill" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@drawable/login_card"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Large" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱8.00 / egg" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,470 eggs" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/chart_bar_track" android:weightSum="1000">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1000" android:background="@drawable/chart_bar_fill" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@drawable/login_card"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Extra large" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₱9.00 / egg" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="630 eggs" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/chart_bar_track" android:weightSum="1000">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="429" android:background="@drawable/chart_bar_fill" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Today's stock movement" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Opening stock" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="3,600 eggs&#10;Harvest recorded  +600&#10;Completed sales  −390&#10;Approved losses  −30" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Available stock · 3,780" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:id="@+id/add_harvest" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="＋  Add harvest" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/report_loss" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="▤  Report loss" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
