<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_success_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  Synced · All changes up to date" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="These farm-gate prices apply to new sales." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Version 12" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Farm-gate cash prices" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:padding="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Small" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><EditText android:id="@+id/price_small" android:layout_width="90dp" android:layout_height="38dp" android:background="@drawable/input_outline" android:gravity="center" android:inputType="numberDecimal" android:text="₱6.00" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:padding="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Medium" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><EditText android:id="@+id/price_medium" android:layout_width="90dp" android:layout_height="38dp" android:background="@drawable/input_outline" android:gravity="center" android:inputType="numberDecimal" android:text="₱7.00" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:padding="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Large" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><EditText android:id="@+id/price_large" android:layout_width="90dp" android:layout_height="38dp" android:background="@drawable/input_outline" android:gravity="center" android:inputType="numberDecimal" android:text="₱8.00" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/login_card" android:gravity="center_vertical" android:padding="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Extra large" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><EditText android:id="@+id/price_xl" android:layout_width="90dp" android:layout_height="38dp" android:background="@drawable/input_outline" android:gravity="center" android:inputType="numberDecimal" android:text="₱9.00" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Current price list" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Version 12" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Last changed 7 Oct · Elena Reyes" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:id="@+id/save_prices" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="▣  Save prices" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New sales only" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Price updates apply to new sales after they are saved. Completed sales keep their original prices." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
