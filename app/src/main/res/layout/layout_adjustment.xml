<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   <ViewStub android:id="@+id/adjustment_error_state" android:layout="@layout/pt_state_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_pending_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌁  Request saved on this device" android:textColor="@color/status_pending" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your request will be reviewed by an administrator. Inventory changes only after approval." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pending approval" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Adjustment details" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adjustment type" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/adjustment_type" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="Loss reason · Breakage" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Egg size" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/adjustment_size" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="Large" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lost eggs" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/adjustment_qty" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="12" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <ViewStub android:id="@+id/adjustment_invalid_quantity" android:layout="@layout/pt_invalid_field" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reason / notes" android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" /><EditText android:id="@+id/adjustment_reason" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/input_outline" android:hint="Cracked during tray transfer" android:paddingStart="10dp" android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Requested by" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Maria Santos" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="8 Oct 2026 · Sales Personnel" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:id="@+id/approve_adjustment" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="✓  Approve &amp; deduct 12 eggs" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <TextView android:id="@+id/reject_adjustment" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="×  Reject request" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stock impact if approved" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Current large eggs  1,470\nRequested loss  −12\nLarge eggs after approval  1,458" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
