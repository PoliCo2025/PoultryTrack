<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/off_white" android:orientation="vertical">
    <include layout="@layout/pt_header" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
            <ProgressBar android:id="@+id/pos_loading" android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal" android:layout_margin="12dp" android:visibility="gone" />
            <TextView android:id="@+id/pos_context_message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:background="@drawable/status_info_card" android:padding="10dp"
                android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:visibility="gone" />
            <TextView android:id="@+id/pos_retry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:padding="4dp" android:text="Refresh products and prices"
                android:textColor="@color/farm_green" android:textSize="10sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Walk-in customer · Cash sale"
                    android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Add eggs by size" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="6dp"
                android:text="Eggs by size" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/pos_products" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/pos_empty_products" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="10dp" android:text="No products are available." android:textColor="@color/muted_gray_green" android:textSize="10sp" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp"
                android:text="Sale items" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/pos_cart_lines" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp" />
            <TextView android:id="@+id/pos_empty_cart" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="8dp" android:text="Your cart is empty." android:textColor="@color/muted_gray_green" android:textSize="10sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total amount"
                    android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/pos_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="₱0.00" android:textColor="@color/dark_charcoal_green" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/pos_currency_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="Cash sale · PHP" android:textColor="@color/muted_gray_green" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cash received (₱)"
                    android:textColor="@color/dark_charcoal_green" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/cash_received" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp"
                    android:background="@drawable/input_outline" android:hint="0.00" android:inputType="numberDecimal" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:singleLine="true" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/pos_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:background="@drawable/status_success_card" android:padding="10dp" android:text="Change · ₱0.00"
                android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/pos_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:background="@drawable/status_error_card" android:padding="10dp" android:textColor="@color/status_error" android:textSize="10sp" android:visibility="gone" />
            <TextView android:id="@+id/complete_sale" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
                android:background="@drawable/signin_button" android:gravity="center" android:text="✓  Complete cash sale"
                android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="6dp"
                android:text="Sale records are saved locally on this device. Completed sales keep their original prices."
                android:textColor="@color/muted_gray_green" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
