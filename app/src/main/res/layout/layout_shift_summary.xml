<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/off_white" android:orientation="vertical">
 <include layout="@layout/pt_header" />
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:id="@+id/page_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
   
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_success_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  8 Oct 2026 · Morning" android:textColor="@color/status_success" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Maria Santos · 8:00 AM–10:42 AM · Counter 01" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Open shift" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="In cash sales" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="₱3,000.00" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="6 completed transactions · 390 eggs sold" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Cash reconciliation" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expected cash in drawer" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Opening cash float  ₱3,000.00\nCash sales (net of change)  +₱2,940.00\nExpected cash in drawer  ₱5,940.00" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Latest sale · PT-1000-0089  ₱660.00" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="Latest finalized sale" android:textColor="@color/dark_charcoal_green" android:textSize="13sp" android:textStyle="bold" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/login_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PT-1000-0089 · 10:42 AM" android:textColor="@color/dark_charcoal_green" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="₱660.00" android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Finalized · Pending sync" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/status_pending_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌁  Your report includes local sales" android:textColor="@color/status_pending" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1 of 3 records are finalized. Pending records are marked offline." android:textColor="@color/dark_charcoal_green" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/muted_gray_green" android:textSize="9sp" /></LinearLayout>
   <TextView android:id="@+id/export_shift" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="▣  Export PDF" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
   <TextView android:id="@+id/share_shift" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:background="@drawable/signin_button" android:gravity="center" android:text="♧  Share PDF" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
  </LinearLayout>
 </ScrollView>
 <include layout="@layout/pt_bottom_nav" />
</LinearLayout>
